# ==============================================================================
# AgriSmart Full-Stack Production Environment Configuration
# Copy this file to backend/.env (or set variables in your cloud provider dashboard)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Security: Set to false in production to prevent auto-filling OTP in HTTP response
ALLOW_DEV_OTP=false

# CORS & Domain Restrictions (Leave empty for local, or set your production URL e.g. https://agrismart.onrender.com)
# FRONTEND_ORIGIN=https://your-domain.com

# Reverse Proxy Trust: Set to true if behind Cloudflare, Nginx, or AWS ALB
TRUSTED_PROXIES=false

# ------------------------------------------------------------------------------
# 2. Payment Gateway (Razorpay & Escrow)
# If left unset, the platform runs in automated Sandbox Simulation mode
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. SMS Gateways (For Real Mobile Phone OTP Delivery)
# Fast2SMS (Recommended for India) OR Twilio (International) OR Custom Webhook
# ------------------------------------------------------------------------------
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# SMS_WEBHOOK_URL=https://your-sms-webhook.com/api/send

# ------------------------------------------------------------------------------
# 4. Email Gateway (For Real Email OTP & Notifications)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=AgriSmart Support <support@yourdomain.com>

# ------------------------------------------------------------------------------
# 5. Live Government Mandi Rates (Data.gov.in / Agmarknet API)
# Register free at https://data.gov.in to get your API key
# If left unset, platform uses the built-in verified mandi dataset
# ------------------------------------------------------------------------------
# DATA_GOV_IN_API_KEY=your_datagov_api_key_here

# ------------------------------------------------------------------------------
# 6. Cloud Image Storage (Cloudinary)
# If left unset, images are stored locally in frontend/uploads/
# ------------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret

# ------------------------------------------------------------------------------
# 7. AI Advisory & Crop Disease Diagnosis (Google Gemini API)
# Get a free key at https://aistudio.google.com
# If left unset, the platform uses intelligent offline agricultural heuristics
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 8. Storage Paths (Optional: defaults to backend/data/db.json and frontend/)
# ------------------------------------------------------------------------------
# DATA_PATH=/app/backend/data/db.json
# PUBLIC_DIR=/app/frontend
